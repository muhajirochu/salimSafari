# Copy this file to `.env` and fill in your values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Cloudinary (Dashboard → top-left "Cloud name")
VITE_CLOUDINARY_CLOUD_NAME=

# Cloudinary unsigned upload preset (Settings → Upload → Upload presets → Signing mode: Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: override the default admin password (NOTE: visible in the browser bundle — not real security)
VITE_ADMIN_PASSWORD=
